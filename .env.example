# ==============================================================================
# LeadPilot Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - Use placeholder values only in this template.
# - Copy this file to .env.local to supply your real credentials.
# - NEVER commit .env.local or expose private keys to version control.
# - When placeholders remain active, LeadPilot automatically operates in
#   deterministic local mock adapter mode.
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Client-side Auth & Firestore)
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side Only)
# Obtain these from: Firebase Console -> Project Settings -> Service accounts -> Generate private key
# CRITICAL: NEVER prefix these with NEXT_PUBLIC_
# ------------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# AI Provider Configuration (Future LLM API)
# Server-side only
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
LLM_MODEL=gpt-4o
